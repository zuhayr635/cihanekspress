datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model StoreSetting {
  id                      String   @id @default("default")
  storeName               String   @default("LUXE ATELIER")
  storeTagline            String   @default("Kişiye Özel Lüks Koleksiyon")
  storeMode               String   @default("CATALOG_ONLY") // "CATALOG_ONLY" | "INVITE_ONLY" | "PUBLIC_SALE"
  logoUrl                 String   @default("")
  headerBrandMode         String   @default("BOTH") // "LOGO_ONLY" | "TEXT_ONLY" | "BOTH"
  headerPrimaryText       String   @default("cihan")
  headerSecondaryText     String   @default("ekspress")
  headerSuffixText        String   @default(".com")
  showHeaderSubtitle      Boolean  @default(true)
  headerSubtitle          String   @default("RC SCALE CRAWLER ATÖLYE SERGİ KATALOĞU")
  logoHeight              Int      @default(38)
  currency                String   @default("TL")
  currencySymbol          String   @default("₺")
  taxRate                 Int      @default(20)
  pricesIncludeTax        Boolean  @default(true)
  freeShippingThreshold   Float    @default(2000.0)
  defaultShippingFee      Float    @default(95.0)
  bankTransferEnabled     Boolean  @default(true)
  bankAccountsJson        String   @default("[{\"bankName\":\"Garanti BBVA\",\"accountHolder\":\"LUXE ATELIER TEKSTIL A.Ş.\",\"iban\":\"TR12 0006 2000 0001 2345 6789 01\"},{\"bankName\":\"Türkiye İş Bankası\",\"accountHolder\":\"LUXE ATELIER TEKSTIL A.Ş.\",\"iban\":\"TR34 0006 4000 0002 3456 7890 12\"}]")
  whatsappOrderEnabled    Boolean  @default(true)
  whatsappPhone           String   @default("+905550001122")
  whatsappMessageTemplate String   @default("Merhaba, web sitenizden aşağıdaki ürünleri sipariş vermek istiyorum:\n\n{items}\n\nToplam Tutar: {total}\nAlıcı: {customerName}\nTeslimat Adresi: {address}")
  creditCardEnabled       Boolean  @default(true)
  creditCardProvider      String   @default("paytr") // "paytr" | "iyzico"
  ccApiKey                String   @default("")
  ccSecretKey             String   @default("")
  ccMerchantId            String   @default("")
  ccTestMode              Boolean  @default(true)
  panicMode               Boolean  @default(false) // Zabıta & Denetim Acil Durum Kalkanı
  usdRate                 Float    @default(38.50) // Manuel Dolar Kuru (USD/TRY)
  blockedIpsJson          String   @default("[]")  // Şüpheli IP Engelleme Listesi
  // 5 Gizli IBAN & Stealth Satış Operasyonu Ayarları
  kuruEslestirmeEnabled     Boolean  @default(true)  // 1. Kuruşlu Referans Eşleştirme Motoru
  burnerTimeoutMinutes      Int      @default(15)    // 3. Hayalet Ödeme Odası Süresi (dk)
  stealthCamouflageEnabled  Boolean  @default(true)  // 4. Masum Hizmet / Kamuflaj Dekont Modu
  stealthServiceTitle       String   @default("3D CAD Çizim ve Teknik Modelleme Hizmet Bedeli")
  safeMemosJson             String   @default("[\"Teknik Danışmanlık Hizmet Bedeli\",\"3D CAD Modelleme\",\"Emanet İadesi\",\"Yazılım ve Tasarım Desteği\",\"Proje Çizim Bedeli\"]")
  honeypotEnabled           Boolean  @default(true)  // 5. Ters Ağ Tuzağı & Sahte Bakım Modu
  honeypotMode              String   @default("MAINTENANCE") // "MAINTENANCE" | "NOT_FOUND" | "TECHNICAL_PORTAL"
  honeypotMessage           String   @default("Sistem Bakımı: Bankacılık API entegrasyonumuzda altyapı çalışması yapılmaktadır. Lütfen daha sonra tekrar deneyiniz.")
  updatedAt               DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model InviteToken {
  id              String    @id @default(cuid())
  token           String    @unique
  status          String    @default("ACTIVE") // ACTIVE | USED | EXPIRED | REVOKED
  note            String?
  discountPercent Int       @default(0)
  expiresAt       DateTime?
  usedAt          DateTime?
  usedByIp        String?
  createdAt       DateTime  @default(now())
  orders          Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  order       Int       @default(0)
  products    Product[]
}

model Product {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  description      String
  shortDescription String?
  images           String           @default("[]") // JSON string array of URLs
  type             String           @default("SIMPLE") // "SIMPLE" | "VARIABLE" | "DIGITAL" | "BUNDLE"
  basePrice        Float
  salePrice        Float?
  costPrice        Float?           // Alış / Parça Maliyeti (COGS Kârlılık Hesabı)
  sku              String?
  stockQuantity    Int              @default(10)
  manageStock      Boolean          @default(true)
  allowBackorders  Boolean          @default(false)
  lowStockThreshold Int             @default(3)
  isFeatured       Boolean          @default(false)
  digitalFileUrl   String?
  videoUrl         String?
  weight           Float?
  dimensions       String?
  attributesJson   String?          @default("[]") // JSON: [{ "name": "Beden", "options": ["S", "M", "L"] }]
  compatibleModels String?          @default("[]") // Uyumlu Modeller: ["TRX-4", "SCX10 III", "Element", "SCX24"]
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  reviews          ProductReview[]
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String   // e.g. "Siyah / M"
  sku        String?
  price      Float
  stock      Int      @default(5)
  attributes String   @default("{}") // JSON: { "Renk": "Siyah", "Beden": "M" }
  image      String?
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    @default("PERCENTAGE") // "PERCENTAGE" | "FIXED_CART" | "FIXED_PRODUCT"
  amount      Float
  minSpend    Float?
  maxSpend    Float?
  usageLimit  Int?
  usageCount  Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model ProductReview {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName      String
  rating          Int      @default(5)
  comment         String
  isApproved      Boolean  @default(false)
  isVerifiedOwner Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  billingAddress  String?
  city            String
  district        String?
  customerNote    String?
  adminNote       String?
  status          String      @default("PENDING_PAYMENT") // PENDING_PAYMENT | PROCESSING | SHIPPED | COMPLETED | CANCELLED | REFUNDED
  paymentMethod   String      // BANK_TRANSFER | WHATSAPP | CREDIT_CARD
  paymentStatus   String      @default("PENDING") // PENDING | COMPLETED | FAILED
  subtotal        Float
  discountTotal   Float       @default(0.0)
  taxTotal        Float       @default(0.0)
  shippingFee     Float       @default(0.0)
  total           Float
  receiptUrl      String?
  trackingNumber  String?
  trackingUrl     String?
  inviteTokenId   String?
  inviteToken     InviteToken? @relation(fields: [inviteTokenId], references: [id])
  // Stealth IBAN & Burner Fields
  exactAmount     Float?       // Kuruşlu net tutar (örn: 14500.42)
  kuruSuffix      Float?       // Eklenen kuruş (örn: 0.42)
  assignedIbanId  String?      // Dinamik havuzdan atanan IBAN ID
  assignedIbanJson String?     // Snapshot: { bankName, accountHolder, iban }
  burnerExpiresAt DateTime?    // Hayalet ödeme odası son geçerlilik anı
  isBurnerExpired Boolean      @default(false)
  safeMemo        String?      // Seçilen kamuflaj transfer açıklaması
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  productTitle String
  variantName  String?
  price        Float
  quantity     Int
  total        Float
}

// 15 Özel Modül Konfigürasyon ve Aktif/Pasif Tablosu
model ModuleConfig {
  id            String   @id @default(cuid())
  key           String   @unique // örn: "cog_simulator", "gear_calculator", "b2b_quotes"
  name          String   // Modül görünen adı
  category      String   // "TEKNIK", "TICARI", "ATOLYE", "TOPLULUK"
  isEnabled     Boolean  @default(true) // Admin panelden Aç/Kapa
  description   String
  settingsJson  String   @default("{}") // Modüle özel ayarlar (JSON)
  orderIndex    Int      @default(0)
  updatedAt     DateTime @updatedAt
}

// 5. B2B & Kulüp Toplu Teklif İstekleri
model B2BQuote {
  id              String   @id @default(cuid())
  companyName     String
  contactName     String
  phone           String
  email           String
  vehicleCount    Int      @default(1)
  targetBudget    Float?
  notes           String
  status          String   @default("PENDING") // PENDING | REVIEWED | OFFER_SENT | REJECTED
  adminReplyNote  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 6. Eski Şasini Getir / Takas Değerleme Talepleri
model TradeIn {
  id              String   @id @default(cuid())
  customerName    String
  phone           String
  currentChassis  String   // Mevcut araba/şasi modeli
  condition       String   // TEMIZ | ORTA | YIPRANMIS | SADECE_SASI
  expectedPrice   Float?
  desiredProduct  String?  // Almak istediği yeni ürün/kit
  photoUrlsJson   String   @default("[]") // Yüklenen görseller
  adminOfferPrice Float?   // Yöneticinin biçtiği takas bedeli
  status          String   @default("PENDING") // PENDING | EVALUATED | ACCEPTED | REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 12. 3D Baskı Parça Üretim Talepleri
model Print3d {
  id              String   @id @default(cuid())
  customerName    String
  phone           String
  email           String
  projectTitle    String
  fileUrl         String?  // Yüklenen STL veya görsel
  scale           String   @default("1/10") // 1/10 | 1/24 | OZEL
  material        String   @default("PETG") // PLA | PETG | TPU | KARBON_FIBER | REÇINE
  color           String   @default("Siyah")
  notes           String?
  adminPrice      Float?
  status          String   @default("PENDING") // PENDING | QUOTED | PRINTING | SHIPPED | REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 13. Türkiye RC Crawler Parkur & Rota Noktaları
model TrailSpot {
  id            String   @id @default(cuid())
  name          String   // Örn: "Aydos Ormanı Kaya Parkuru"
  city          String   // Örn: "İstanbul / Kartal"
  difficulty    String   @default("ORTA") // KOLAY | ORTA | ZOR | ASIRI_KAYA
  terrain       String   @default("KAYA") // KAYA | ORMAN | KUM | CAMUR
  description   String
  coordinates   String?  // Örn: "40.9412, 29.2481"
  coverImage    String?
  isApproved    Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// 14. Ayın Kaya Canavarı & Topluluk Galerisi
model RigShowcase {
  id            String   @id @default(cuid())
  authorName    String
  city          String
  vehicleModel  String   // Örn: "TRX-4 Custom Carbon Edition"
  specsJson     String   @default("{}") // Motor, esc, aks, ağırlık
  photoUrl      String
  votesCount    Int      @default(0)
  isWinner      Boolean  @default(false)
  isApproved    Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// 8. Tescilli Şasi Seri Numarası Sistemi
model CertifiedChassis {
  id                String   @id @default(cuid())
  serialNumber      String   @unique // Örn: "CHP-CRAWLER-007"
  ownerName         String
  buildDate         String
  builderSignature  String   @default("CIHANPOL MASTER BUILDER")
  specsJson         String   @default("{}")
  isVerified        Boolean  @default(true)
  createdAt         DateTime @default(now())
}

// 9. Canlı Atölye Montaj Günlüğü
model BuildLog {
  id            String   @id @default(cuid())
  orderNumber   String   // İlgili sipariş no (örn: CHP-178897)
  stageTitle    String   // Örn: "Aks & Dişli Yağlama Aşaması"
  description   String
  photoUrl      String?
  date          DateTime @default(now())
}

// 2. Dinamik IBAN Havuzu & Akıllı Hesap Rotasyonu (Stealth Cash Vault)
model IbanAccount {
  id                 String   @id @default(cuid())
  bankName           String
  accountHolder      String
  iban               String   @unique
  dailyLimit         Float    @default(75000.0) // Günlük Maksimum Hacim Limiti (TL)
  currentDailyTotal  Float    @default(0.0)     // Bugün giren tahmini tutar
  dailyOrderLimit    Int      @default(15)      // Günlük Maksimum İşlem Sayısı
  currentOrderCount  Int      @default(0)       // Bugün yönlendirilen sipariş adedi
  isActive           Boolean  @default(true)    // Havuzda aktif mi?
  priorityOrder      Int      @default(0)       // Öncelik sırası (küçük sayı önce)
  notes              String?                    // Not / Açıklama (örn: "Şahıs hesabı A", "Yedek hesap")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

